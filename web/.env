# Public, build-time values. NEXT_PUBLIC_* is inlined into the browser bundle
# by `next build`, so these must exist AT BUILD TIME.
#
# Committed on purpose. Every value here is already visible to anyone who
# opens the site — the HubSpot portal id and form GUIDs are in the page source
# of any embedded form, and the Sanity project id ships in the JavaScript.
#
# They live here rather than only in Cloudflare's build variables because the
# HubSpot keys were missing from the deployed build, which meant every form on
# the live site reported success and sent nothing. A committed file cannot
# drift from the code that depends on it.
#
# Never put a secret in this file. SANITY_API_READ_TOKEN stays in .env.local
# and in `wrangler secret put`.
NEXT_PUBLIC_SANITY_PROJECT_ID=phzyp5b1
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=441648495
NEXT_PUBLIC_HUBSPOT_REGION=ap1
NEXT_PUBLIC_HUBSPOT_FORM_CONTACT=e3ce7dfa-4747-4f39-8505-399c57284b66
NEXT_PUBLIC_HUBSPOT_FORM_NEWSLETTER=ae4e4fc6-4ada-4879-a313-4abf98250e35
NEXT_PUBLIC_HUBSPOT_FORM_EVENT=80e7b93f-7641-4e5d-9b40-c4c81050103e
NEXT_PUBLIC_HUBSPOT_FORM_RESOURCE=4af19f75-bad8-4d24-859d-45a77bbf175d
NEXT_PUBLIC_HUBSPOT_FORM_CAREERS=bc42f48c-f2d0-4e6c-a3bc-59100cff23c4
